<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/bg" android:gravity="center">
    <TextView android:id="@+id/nCity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Konum" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/nIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textColor="#FFFFFF" android:textSize="34sp" android:maxLines="1" android:ellipsize="end" android:layout_marginEnd="6dp"/>
        <TextView android:id="@+id/nTemp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="42sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/nDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/nExtra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#E0EAFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/nStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="#C7D7FE" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
