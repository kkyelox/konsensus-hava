<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#EEF3F9" android:fitsSystemWindows="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐 Konsensüs Hava" android:textSize="24sp" android:textStyle="bold" android:textColor="#1E3A8A" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:text="Widget için konum seç. Ana ekranda boş bir yere basılı tut → Widget\'lar → Konsensüs Hava → “Yağmur (3 gün)”." android:textSize="14sp" android:textColor="#475569" />
    <TextView android:id="@+id/current" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:padding="12dp" android:background="#FFFFFF" android:text="Seçili konum: yok" android:textSize="15sp" android:textColor="#0F172A" />
    <Button android:id="@+id/gps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="📍 Konumumu kullan" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="veya şehir / ilçe ara:" android:textColor="#475569" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/query" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="ör. Kadıköy" android:inputType="text" android:imeOptions="actionSearch" />
        <Button android:id="@+id/search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ara" />
    </LinearLayout>
    <LinearLayout android:id="@+id/results" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    <TextView android:id="@+id/msg" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="#B45309" android:text="" />
    <Button android:id="@+id/open" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Siteyi aç (tüm ayrıntılar)" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:textSize="12sp" android:textColor="#64748B"
        android:text="Widget 30 dakikada bir kendini yeniler (⟳ ile hemen yenileyebilirsin). Yüzde: o gün en az 0,5 mm yağış olasılığı — 9 küresel model ve ECMWF + NOAA ansambl senaryoları. Veri: Open-Meteo (CC BY 4.0)." />
</LinearLayout>
</ScrollView>
